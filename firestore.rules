rules_version = '2';

// Each user's data lives in a top-level collection named after their email
// address (the layout used since v1). Only that signed-in user may access it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{email}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
    }
  }
}
